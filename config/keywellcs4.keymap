        leaderKey_1: leaderKey_1 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            KeyCluShowShortcutsFix {
                sequence = <S H O>;
                bindings = <&KeyClu_Show_Shortcuts_m>;
            };
        };

        Test_Mac_UA_Nonfits: Test_Mac_UA_Nonfits {
            compatible = "zmk,behavior-tap-dance";
            label = "TEST_MAC_UA_NONFITS";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&sl 18>;

            tapping-term-ms = <350>;
        };

        Test_iPad_UA_Nonfits: Test_iPad_UA_Nonfits {
            compatible = "zmk,behavior-tap-dance";
            label = "TEST_IPAD_UA_NONFITS";
