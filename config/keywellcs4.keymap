                <&kt_off F24 &tog_of 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp Q                          &kp W                 &Layer_Tap_Timeless_Left 28 E  &P_Tabs_Timeless_left 0 R      &kp T                          &kp Y                       &Layer_Tap_Timeless_Right 10 U  &Layer_Tap_Timeless_Right 28 I  &kp O        &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &hml RIGHT_CONTROL A  &hml LEFT_CONTROL S            &hml LALT D                    &hml LCMD F                    &D_Tasks_Timeless_left 0 G  &kp H                           &hmr LCMD J                     &hmr LALT K  &hmr LEFT_CONTROL L           &hmr RIGHT_CONTROL SEMI
&Layer_Tap_Timeless_Left 13 Z  &lt 22 X              &lt 23 C                       &lt 21 V                       &Layer_Tap_Timeless_Left 12 B  &kp N                       &kp M                           &kp COMMA                       &kp DOT      &kp FSLH
                               &tog_on 8             &mo 27                         &HyperMac_HT_Timeless 0 SPACE  &Thumb_HT_VeryShort 9 TAB      &Thumb_HT_Normal 8 ESCAPE   &none                           &none                           &none        &Backspase_MacLike_mod_morph  &kp ENTER                &Thumb_HT_VeryShort 7 SPACE
            >;
        };

        Mac-EN-QWERTY {
            // Keys physically like EN Colemak, but produce correct letters when system is in QWERTY (EN).
            // This allows to type on devices where Colemak is not supported.
            // Use Cases:
            //     - iPad
            //     - other people's machines
            //     - remote Mac / Machines where you don't bother yourself or not allowed to set Colemak

            bindings = <
&kp Q                          &kp W                 &Layer_Tap_Timeless_Left 28 F  &P_Tabs_Timeless_left 0 P      &kp G                          &kp J                       &Layer_Tap_Timeless_Right 10 L  &Layer_Tap_Timeless_Right 28 U  &kp Y        &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &hml RIGHT_CONTROL A  &hml LEFT_CONTROL R            &hml LALT S                    &hml LCMD T                    &D_Tasks_Timeless_left 0 D  &kp H                           &hmr LCMD N                     &hmr LALT E  &hmr LEFT_CONTROL I           &hmr RIGHT_CONTROL O
&Layer_Tap_Timeless_Left 13 Z  &lt 22 X              &lt 23 C                       &lt 21 V                       &Layer_Tap_Timeless_Left 12 B  &kp K                       &kp M                           &kp COMMA                       &kp DOT      &kp FSLH
                               &tog_on 8             &mo 27                         &HyperMac_HT_Timeless 0 SPACE  &Thumb_HT_VeryShort 9 TAB      &Thumb_HT_Normal 8 ESCAPE   &none                           &none                           &none        &Backspase_MacLike_mod_morph  &kp ENTER             &Thumb_HT_VeryShort 7 SPACE
            >;
        };

        Mac-UA-QWERTY {
            // Keys physically like UA Colemak, but produce correct letters when system is QWERTY (UA).
            // This allows to type on devices where Colemak is not supported.
            // Use Cases:
            //     - iPad
            //     - other people's machines
            //     - remote Mac / Machines where you don't bother yourself or not allowed to set Colemak

            bindings = <
&kp Z                          &kp I                 &Layer_Tap_Timeless_Left 28 A  &P_Tabs_Timeless_left 0 G  &kp U                              &kp Q                       &Layer_Tap_Timeless_Right 10 K  &Layer_Tap_Timeless_Right 28 E  &kp B              &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &hml RIGHT_CONTROL F  &hml LEFT_CONTROL H            &hml LALT C                &hml LEFT_COMMAND N                &D_Tasks_Timeless_left 0 L  &kp X                           &hmr LEFT_COMMAND Y             &hmr LALT T        &hmr LEFT_CONTROL S  &hmr RIGHT_CONTROL J
&Layer_Tap_Timeless_Left 13 P  &lt 22 LEFT_BRACKET   &lt 23 W                       &lt 21 D                   &Layer_Tap_Timeless_Left 12 COMMA  &kp R                       &kp V                           &UK_Comma_Symbol                &UK_Period_Symbol  &UK_Question_Symbol
                               &trans                &trans                         &trans                     &trans                             &trans                      &trans                          &trans                          &trans             &trans               &trans                &Thumb_HT_VeryShort 6 SPACE
            >;
        };

        Mac-HRM-UA-QWERTY {
            display-name = "ToDo-Mege- Differs from iPad only by Global";
            bindings = <
&trans          &trans                            &trans                              &trans  &trans                          &trans  &trans  &trans                          &trans  &trans
&kp LEFT_SHIFT  &MacOS_Globe_non_en_fix_LHRM 0 F  &MacOS_Control_non_en_fix_LHRM 0 H  &trans  &MacOS_CMD_non_en_fix_LHRM 0 N  &trans  &trans  &MacOS_CMD_non_en_fix_RHRM 0 Y  &trans  &MacOS_Control_non_en_fix_RHRM 0 S  &MacOS_Globe_non_en_fix_RHRM 0 J
&trans          &trans                            &trans                              &trans  &trans                          &trans  &trans  &trans                          &trans  &trans
                &trans                            &trans                              &trans  &trans                          &trans  &trans  &trans                          &trans  &trans                              &trans                            &trans
            >;
        };

        iPad-HRM-EN-QWERTY {
        // Only Globe
        // Brings back normal standard ZMK Globe. Why not re-uses Mac's one? Because there is nothing to re-use:
        // MacOS ignores avaluabuk in ZMK GLOBE, so Mac's layer is already hacked and iPad should revet hack to defaults

            bindings = <
&trans          &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &hml GLOBE A  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &hmr GLOBE O
&trans          &trans        &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
                &trans        &trans  &mt LA(LC(LEFT_COMMAND)) SPACE  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans
            >;
        };

        iPad-HRM-UA-QWERTY {
            display-name = "iPad-UK-ShortCutsFix";
            bindings = <
&trans          &trans                              &trans                                &trans  &trans                            &trans  &trans  &trans                            &trans  &trans
&kp LEFT_SHIFT  &iOS_Globe_non_qwerty_fix_LHRM 0 F  &iOS_Control_non_qwerty_fix_LHRM 0 H  &trans  &iOS_CMD_non_qwerty_fix_LHRM 0 N  &trans  &trans  &iOS_CMD_non_qwerty_fix_RHRM 0 Y  &trans  &iOS_Control_non_qwerty_fix_RHRM 0 S  &iOS_Globe_non_qwerty_fix_RHRM 0 J
&trans          &trans                              &trans                                &trans  &trans                            &trans  &trans  &trans                            &trans  &trans
                &trans                              &trans                                &trans  &trans                            &trans  &trans  &trans                            &trans  &trans                                &trans                              &trans
            >;
        };

        Symbols_UK_QWERTY {
            bindings = <
&En_Uk_exclamation_and_warning  &kp UNDER  &kp LC(LA(LS(COMMA)))  &kp LC(LA(LEFT_BRACKET))      &kp LC(LA(GRAVE))                   &kp LA(N3)               &kp LC(LA(RIGHT_BRACKET))      &En_Uk_exclamation_and_warning       &Uk_Ampersan_override_tied_Shift  &trans
&kp LEFT_SHIFT                  &kp EQUAL  &kp MINUS              &hml LALT PLUS                &hml LEFT_COMMAND LEFT_PARENTHESIS  &kp LA(N6)               &kp LA(N4)                     &hmr LEFT_COMMAND RIGHT_PARENTHESIS  &hmr LEFT_ALT LA(LC(COLON))       &kp LC(LA(LS(SINGLE_QUOTE)))  &kp LC(LA(APOSTROPHE))
&kp LA(LC(BACKSLASH))           &kp LA(M)  &kp LA(N8)             &kp LC(LA(LS(LEFT_BRACKET)))  &kp LS(N5)                          &kp LA(N2)               &kp LA(LC(LS(RIGHT_BRACKET)))  &kp LA(LC(SEMI))                     &kp LA(LC(PERIOD))                &kp LA(LS(LC(SLASH)))
                                &trans     &trans                 &mo 24                        &Symbol_Sys_Layout_Macro            &Emoji_Sys_Layout_macro  &trans                         &trans                               &trans                            &trans                        &trans                  &trans
            >;
        };

        Symbols_EN {
            //        &hml LEFT_COMMAND LEFT_PARENTHESIS
            //                  is to make CMD-+ shortcut (increase/decrease browrer page) layer- & key-race agnostic.
            //                  So it worked not only when you hit cmd-mo(symbol layer)-kp(+/-) but even
            //                  when you key-rased as mo(symbol layer)- kp(cmd)-kp(+/-). Try with hands and you understand

            bindings = <
&En_Uk_exclamation_and_warning  &kp UNDER  &kp LESS_THAN  &kp LEFT_BRACKET  &kp GRAVE                           &kp HASH                 &kp RIGHT_BRACKET  &EN_greaters_and_trialgles           &En_Ampersan_override_tied_Shift  &trans
&kp LEFT_SHIFT                  &kp EQUAL  &kp MINUS      &hml LALT PLUS    &hml LEFT_COMMAND LEFT_PARENTHESIS  &kp CARET                &kp DOLLAR         &hmr LEFT_COMMAND RIGHT_PARENTHESIS  &hmr LALT COLON                   &kp DOUBLE_QUOTES  &kp APOSTROPHE
&kp BACKSLASH                   &kp TILDE  &kp ASTERISK   &kp LEFT_BRACE    &kp PERCENT                         &kp AT                   &kp RIGHT_BRACE    &kp SEMI                             &kp PERIOD                        &kp QUESTION
                                &trans     &trans         &mo 24            &Symbol_Sys_Layout_Macro            &Emoji_Sys_Layout_macro  &trans             &trans                               &trans                            &trans             &trans          &trans
            >;
        };

        Numbers_And_Media {
            //
            //      ← → Arrows - Youtube, VLC, some online players: skip Fast Forward/Backward/Rewind
            //                   Apple Music: duplicate function of Next/Previous track
            //      J/Shift    - Youtube: Faster Rewind (J)
            //      L          - Youtube: Fast Forward
            //      Shift      - compatibilyty for Scrensot Shortcuts & moving Tabs to N-th Desktop.

            bindings = <
&kp LEFT_ARROW        &none             &none              &kp RIGHT_ARROW   &none       &kp KP_PLUS  &kp N7        &kp N8        &kp N9  &kp KP_MULTIPLY
&mt LEFT_SHIFT J      &kp C_PREVIOUS    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp C_NEXT  &kp L        &kp KP_MINUS  &kp NUMBER_4  &kp N5  &kp N6           &kp KP_DIVIDE
&kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp C_PLAY_PAUSE  &kp C_MUTE  &kp KP_DOT   &kp N1        &kp N2        &kp N3  &kp NUMBER_0
                      &tog_of 8         &none              &trans            &trans      &none        &none         &none         &none   &trans           &trans         &Emoji_Sys_Layout_macro
            >;
        };

        NAV-Apple {
            display-name = "Nav-Apple";
            bindings = <
&none               &none   &none             &HRM_Tabs_layer_for_tabs  &mo 11    &kp HOME          &kp PAGE_UP    &none     &none     &none
&trans              &trans  &kp LEFT_CONTROL  &kp LALT                  &kp LCMD  &kp LEFT_CONTROL  &none          &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT
&kp LC(DOWN_ARROW)  &none   &none             &Flycut_Macro             &none     &kp END           &kp PAGE_DOWN  &none     &none     &none
                    &trans  &trans            &trans                    &trans    &trans            &trans         &trans    &none     &trans        &trans     &Symbol_Sys_Layout_Macro
            >;
        };

        NAV-Apple-TabsNav_rhsLayoutLhs {
            // F20 shortcuts here is an Amethyst layots selection. See more F20 in other layots

            bindings = <
&none  &none  &kp LC(F20)      &kp LA(LS(F20))  &none        &none            &Web_Page_Back_Macro  &none        &none    &Web_Page_Forward_Macro
&none  &none  &kp LS(LC(F20))  &none            &kp LG(F20)  &kp LG(LS(F20))  &none                 &kp LS(TAB)  &kp TAB  &kp LS(TAB)              &kp TAB
&none  &none  &none            &none            &none        &none            &none                 &none        &none    &none
       &none  &none            &none            &none        &none            &none                 &none        &none    &none                    &none    &none
            >;
        };

        NAV-Apple-BrowserGroupNav {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none                      &none
&none  &none  &none  &none  &none  &none  &none  &none  &kp LG(LA(RIGHT_BRACKET))  &kp LG(LA(LEFT_BRACKET))  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                      &none
       &none  &none  &none  &none  &none  &none  &none  &none                      &none                     &none  &none
            >;
        };

        NAV-Apple-WorkSpaceApps {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none          &none  &none
&none  &none  &none  &none  &none  &none  &none  &kp LS(LA(J))  &none  &none  &kp LA(LS(K))
&none  &none  &none  &none  &none  &none  &none  &none          &none  &none
       &none  &none  &none  &none  &none  &none  &none          &none  &none  &none          &none
            >;
        };

        NAV-Apple-AppWindowsCycle {
            // F20 shortcuts here is an Amethyst risizing in split view and so. See more F20 in other layots
            // F11-xx - Switch between Idea/others Focus Editor (E-Editor) & last Tool Window (I-Instruments)
            // App Window Switching:
            //        - on Right: is regular way to switch. There only left and right arrows
            //        - on Left: a) is onehanded switcing, I need when another hand ocupied with mouse. When left hand
            //                      enters this layer with Z, it's motorics is limited and not its not pricise. Thus I
            //                      made for left hand more keys to switch windows than two keys for the right hand.
            //                      They are at positions A=R and S=T.
            //                   b) Plus, one handed swithing with layer is dublicated by AppWindowsSw.. combos.
            //                      Because due to mentioned bad motirics, I often roll keys and have false poritives
            //                      whet A/R/S/T resolved to taps. So I've edded combos wich envolve same keys Z+ARST
            //                      wich handles earlier before false positive tap. In such way if I roll - combos cover
            //                      me and make window swithch. And when I not roll - hold tap layer.
            //         Check commits for denails: e29b7d37b4909a3cf55622e44247970dd6e427ba
            //                                    7906a3aa615c9d78b2ecc074df472e8c55564eea
            //                                    1f7d926b460bcf9e383ee0efb16c31db201d0cb5

            bindings = <
&none  &none              &none              &none          &none          &none  &kp LS(LG(LC(F20)))  &none              &none        &none
&none  &kp LS(LG(GRAVE))  &kp LS(LG(GRAVE))  &kp LG(GRAVE)  &kp LG(GRAVE)  &none  &kp LG(LA(LS(F20)))  &kp LS(LG(GRAVE))  &kp LC(F11)  &kp LC(LS(F11))  &kp LG(GRAVE)
&none  &none              &none              &none          &none          &none  &kp LA(LS(M))        &none              &none        &none
       &none              &none              &none          &none          &none  &none                &none              &none        &none            &kp LA(LS(ENTER))  &none
            >;
        };

        NAV-Ubuntu {
            display-name = "NAV-Ubuntu";
            bindings = <
&none   &none   &none             &none             &mo 16  &kp HOME  &kp PAGE_UP    &none     &none     &none
&trans  &trans  &kp LEFT_CONTROL  &kp LEFT_CONTROL  &mo 25  &none     &none          &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT
&none   &none   &none             &none             &none   &kp END   &kp PAGE_DOWN  &none     &none     &none
        &trans  &trans            &trans            &trans  &trans    &trans         &trans    &none     &trans        &trans     &trans
            >;
        };

        NAV-Ubuntu-TabsNav {
            bindings = <
&none  &none  &none  &none  &none  &none  &kp LG(LEFT_BRACKET)  &none            &none  &kp LG(RIGHT_BRACKET)
&none  &none  &none  &none  &none  &none  &none                 &kp LC(LS(TAB))  &none  &none                  &kp LC(TAB)
&none  &none  &none  &none  &none  &none  &none                 &none            &none  &none
       &none  &none  &none  &none  &none  &none                 &none            &none  &none                  &none        &none
            >;
