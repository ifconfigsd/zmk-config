    conditional_layers {
        compatible = "zmk,conditional-layers";

        MouseWarpConditional {
            if-layers = <21>;
            then-layer = <20>;
        };

        MousePrecisionConditional {
            if-layers = <22>;
            then-layer = <20>;
        };

        MouseRegularConditional {
            if-layers = <23>;
            then-layer = <20>;
        };
    };
};
