        Mac_CMD_Shortcuts_NonEN_WA_m: Mac_CMD_Shortcuts_NonEN_WA_m {
            /*
                f21/F22 - if you want have regular keyboard change layouts to a particular with Bigram/Hyper Layer -
                make it separete shortcut (like ol' LE / LU) ^16499de1
            */

            compatible = "zmk,behavior-macro";
            label = "MAC_CMD_SHORTCUTS_NONEN_WA_M";
            tap-ms = <0>;
            wait-ms = <0>;
            #binding-cells = <0>;
            bindings =
                <&kp F21 &tog_of 1 &kt_on LCMD>,
                <&macro_pause_for_release>,
                <&kt_off LCMD &kp LS(F21) &tog_on 1>;
        };

