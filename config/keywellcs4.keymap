&kp LEFT_SHIFT  &kp A   &kp R   &kp S   &kp T   &kp D   &kp H   &kp N      &kp E    &kp I           &kp O
&kp Z           &kp X   &kp C   &kp V   &kp B   &kp K   &kp M   &kp COMMA  &kp DOT  &kp FSLH
                &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans   &trans          &trans  &mo_Fx_w_unpress_its_Hypr_key_m
            >;
        };

        Fx {
            /*
                Set by "Conditional Alternative" technique.
                Usage:
                    Symbols Thumb key (asume its A) + Hyper Key (asume its B). Order agnostic.
                Implementation:
                    Fx Layer activation is order agnostic, i.e. it has two activation pathes: A-B keys, and B-H keys.
                    A-B:
                          "A" activates Symbols Layer, where "B" key activates Fx.
                    B-A
                        B is already designed to switch to Hyper Layer. But this switching does a bit more to
                        sustain Hyper flows work - it additinaly helds F16 pressed. Thus when A key is pressed as a
                        part of Fx switching route -it should not just &mo to Fx (as in A-B route) but depress F16.
                        For this &mo+depress the "A" key has macro. Another safety net which makes this route working,
                        is that F16 press, is never typed, because karabiner sallows it to set its "hyper" variable.
                Coupling:
                       - "A" & "B" keys
                       - Fx layer must be on top of the layers to which "A" & "B" keys switch
                       - macro that depresses F16 of hyper key.
                       - karabiner's Hyper. Which sallows F16 press to set its "hyper" variable, and never type it.
            */

            bindings = <
&none   &none              &none                &none        &none                &none            &kp F7           &kp F8  &kp F9  &kp F10
&trans  &hml LEFT_SHIFT A  &hml LEFT_CONTROL S  &hml LALT D  &hml LEFT_COMMAND F  &none            &kp KP_NUMBER_5  &kp F4  &kp F5  &kp F6   &kp F11
&none   &none              &none                &none        &none                &kp KP_NUMBER_5  &kp F1           &kp F2  &kp F3  &kp F12
        &trans             &trans               &trans       &trans               &trans           &trans           &trans  &trans  &trans   &trans   &trans
            >;
        };

        Apps {
            bindings = <
&App_Q_TD  &App_W_TD  &App_F_TD  &App_P_TD  &App_G_TD  &App_J_TD  &App_L_TD  &App_U_TD  &App_Y_TD  &none
&none      &App_A_TD  &App_R_TD  &App_S_TD  &App_T_TD  &App_D_TD  &App_H_TD  &App_N_TD  &App_E_TD  &App_I_TD  &App_O_TD
