            layers = <0 1>;
        };

        AppWindowsSwNextP2 {
            bindings = <&kp LG(GRAVE)>;
            key-positions = <21 13>;
            timeout-ms = <150>;
            layers = <0 1>;
        };

        MediaLayerStickLikeWP {
            bindings = <&to 7>;
            key-positions = <1 3>;
            timeout-ms = <150>;
            layers = <7>;
        };

        AND {
            bindings = <&AND_m>;
            key-positions = <7 8>;
            layers = <4 5>;
        };

        OR {
            bindings = <&OR_m>;
            key-positions = <21 22>;
            layers = <4 5>;
            timeout-ms = <100>;
        };

        PutWordInQuotes {
            bindings = <&Put_Word_In_Quotes_m>;
            key-positions = <19 18>;
            layers = <4 5>;
