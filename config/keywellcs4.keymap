#include <behaviors/unicode.dtsi>

/* MEH...
    Keycodes for other locales
    Gives nothing extra except key representation in visual editor
    https://github.com/nickcoutsos/keymap-editor/wiki/Keycodes-for-other-locales
*/
// #include "includes/keys_uk_enhanced.h"

#define DEFAULT 0
#define WARP  21
#define PRESISION  22

#include "includes/mouse.dtsi"
#include <zmk-unicode/keys-extra.h> // All Unicode glyphs except CJK
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// rob"s zmk unicode

&uc {
    default-mode = <UC_MODE_MACOS>;
    minimum-length = <4>;
    macos-key = <LALT>;

    // linux-key = <LC(LS(U))>;
    // win-compose-key = <RALT>;
};

/ {
    behaviors {
        #include "includes/open_app_tap_dances.dtsi"

        Mac_CMD_nonEN_WA_LHRM: Mac_CMD_nonEN_WA_LHRM {
            compatible = "zmk,behavior-hold-tap";
            label = "MAC_CMD_NONEN_WA_LHRM";
            bindings = <&Mac_CMD_Shortcuts_NonEN_WA_m>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 15 16 17 18 25 26 27 28 36 37 38 39 40 41 30 31 32 33 34 35 9 19 29>;
        };

