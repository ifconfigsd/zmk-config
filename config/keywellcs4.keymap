        Mac_Switch_To_UA_m: Mac_Switch_To_UA_m {
            /*
                Macro is mandatory. As keyboard must switch zmk layout too (in addition to sending language changing key
                sequence to karabener which is not possible wo macro)

                For rdp/vnc/remote Karabiner doesn't work. To switch system layouts remotely bypass karabiner.
                For example by using Apple Script added as a service with shortcut.
    		*/

            compatible = "zmk,behavior-macro";
            tap-ms = <0>;
            wait-ms = <0>;
            #binding-cells = <0>;
            bindings = <&kp LS(F21) &tog_on 1>;
            label = "MAC_SWITCH_TO_UA_M";
        };

