    keymap {
        compatible = "zmk,keymap";

        Mac-EN {
            /*
                Keys physically like EN Colemak, but produce correct letters when system is in QWERTY (EN).
                This allows to type on devices where Colemak is not supported.
                Use Cases:
                    - iPad
                    - other people's machines
                    - remote Mac / Machines where you don't bother yourself or not allowed to set Colemak
            */

            bindings = <
&kp Q                          &kp W         &Layer_Tap_Timeless_Left 26 F  &P_Tabs_Timeless_left 0 P      &kp G                          &kp J                       &Layer_Tap_Timeless_Right 9 L  &Layer_Tap_Timeless_Right 26 U  &kp Y        &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &hml GLOBE A  &hml LEFT_CONTROL R            &hml LALT S                    &hml LCMD T                    &D_Tasks_Timeless_left 0 D  &kp H                          &hmr LCMD N                     &hmr LALT E  &hmr LEFT_CONTROL I           &hmr GLOBE O
&Layer_Tap_Timeless_Left 12 Z  &lt 21 X      &lt 22 C                       &lt 20 V                       &Layer_Tap_Timeless_Left 11 B  &kp K                       &kp M                          &kp COMMA                       &kp DOT      &kp FSLH
                               &tog_on 7     &mo 28                         &HyperMac_HT_Timeless 0 SPACE  &Thumb_HT_VeryShort 8 TAB      &Thumb_HT_Normal 7 ESCAPE   &none                          &none                           &none        &Backspase_MacLike_mod_morph  &kp ENTER     &Thumb_HT_VeryShort 4 SPACE
            >;
        };

        Mac-UA {
            /*
                Keys physically like UA Colemak, but produce correct letters when system is QWERTY (UA).
                This allows to type on devices where Colemak is not supported.
                Use Cases:
                    - iPad
                    - other people's machines
                    - remote Mac / Machines where you don't bother yourself or not allowed to set Colemak
            */

            bindings = <
&kp Z                          &kp I                         &Layer_Tap_Timeless_Left 26 A  &P_Tabs_Timeless_left 0 G   &kp U                                    &kp Q                       &Layer_Tap_Timeless_Right 9 K  &Layer_Tap_Timeless_Right 26 E  &kp B                       &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &Mac_GLOBE_nonEN_WA_LHRM 0 F  &Mac_CTRL_nonEN_WA_LHRM 0 H    &Mac_OPT_nonEN_WA_LHRM 0 C  &Mac_CMD_nonEN_WA_LHRM 0 N               &D_Tasks_Timeless_left 0 L  &kp X                          &Mac_CMD_nonEN_WA_RHRM 0 Y      &Mac_OPT_nonEN_WA_RHRM 0 T  &Mac_CTRL_nonEN_WA_RHRM 0 S  &Mac_GLOBE_nonEN_WA_RHRM 0 J
&Layer_Tap_Timeless_Left 12 P  &lt 21 KP_NUMBER_6            &lt 22 W                       &lt 20 D                    &Layer_Tap_Timeless_Left 11 KP_NUMBER_1  &kp R                       &kp V                          &Test_Mac_UA_Nonfits            &kp PERIOD                  &kp SLASH
                               &trans                        &trans                         &trans                      &trans                                   &trans                      &trans                         &trans                          &trans                      &trans                       &trans                        &Thumb_HT_VeryShort 4 SPACE
            >;
        };

        iPad-EN {
            bindings = <
&kp Q                          &kp W         &Layer_Tap_Timeless_Left 26 F  &P_Tabs_Timeless_left 0 P      &kp G                          &kp J                       &Layer_Tap_Timeless_Right 9 L  &Layer_Tap_Timeless_Right 26 U  &kp Y        &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &hml GLOBE A  &hml LEFT_CONTROL R            &hml LALT S                    &hml LCMD T                    &D_Tasks_Timeless_left 0 D  &kp H                          &hmr LCMD N                     &hmr LALT E  &hmr LEFT_CONTROL I           &hmr GLOBE O
&Layer_Tap_Timeless_Left 12 Z  &lt 21 X      &lt 22 C                       &lt 20 V                       &Layer_Tap_Timeless_Left 11 B  &kp K                       &kp M                          &kp COMMA                       &kp DOT      &kp FSLH
                               &tog_on 7     &mo 28                         &HyperMac_HT_Timeless 0 SPACE  &Thumb_HT_VeryShort 8 TAB      &Thumb_HT_Normal 7 ESCAPE   &none                          &none                           &none        &Backspase_MacLike_mod_morph  &kp ENTER     &Thumb_HT_VeryShort 4 SPACE
            >;
        };

        iPad-UA {
            bindings = <
&kp Z                          &kp I                             &Layer_Tap_Timeless_Left 26 A    &P_Tabs_Timeless_left 0 G       &kp U                              &kp Q                       &Layer_Tap_Timeless_Right 9 K  &Layer_Tap_Timeless_Right 26 E  &kp B                           &kp LEFT_SHIFT
&kp LEFT_SHIFT                 &iPad_GLOBE_Phonetic_UA_LHRM 0 F  &iPad_CTRL_Phonetic_UA_LHRM 0 H  &iPad_OPT_Phonetic_UA_LHRM 0 C  &iPad_CMD_Phonetic_UA_LHRM 0 N     &D_Tasks_Timeless_left 0 L  &kp X                          &iPad_CMD_Phonetic_UA_RHRM 0 Y  &iPad_OPT_Phonetic_UA_RHRM 0 T  &iPad_CTRL_Phonetic_UA_RHRM 0 S  &iPad_GLOBE_Phonetic_UA_RHRM 0 J
&Layer_Tap_Timeless_Left 12 P  &lt 21 LEFT_BRACKET               &lt 22 W                         &lt 20 D                        &Layer_Tap_Timeless_Left 11 COMMA  &kp R                       &kp V                          &Test_iPad_UA_Nonfits           &kp SLASH                       &kp LC(LA(SLASH))
                               &trans                            &trans                           &trans                          &trans                             &trans                      &trans                         &trans                          &trans                          &trans                           &trans                            &Thumb_HT_VeryShort 5 SPACE
            >;
        };

        Mac-EN-UA-Symbols {
            /*
                &hml LEFT_COMMAND LEFT_PARENTHESIS
                    is to make CMD-+ shortcut (increase/decrease browrer page) layer- & key-race agnostic.
                    So it worked not only when you hit cmd-mo(symbol layer)-kp(+/-) but even
                    when you key-rased as mo(symbol layer)- kp(cmd)-kp(+/-). Try with hands and you understand
            */

            bindings = <
&kp EXCL        &kp UNDER  &kp LESS_THAN  &kp LEFT_BRACKET  &kp GRAVE                           &kp HASH                 &kp RIGHT_BRACKET  &kp GREATER_THAN                     &kp AMPERSAND    &trans
&kp LEFT_SHIFT  &kp EQUAL  &kp MINUS      &hml LALT PLUS    &hml LEFT_COMMAND LEFT_PARENTHESIS  &kp CARET                &kp DOLLAR         &hmr LEFT_COMMAND RIGHT_PARENTHESIS  &hmr LALT COLON  &kp DOUBLE_QUOTES  &kp APOSTROPHE
&kp BACKSLASH   &kp TILDE  &kp ASTERISK   &kp LEFT_BRACE    &kp PERCENT                         &kp AT                   &kp RIGHT_BRACE    &kp SEMI                             &kp PERIOD       &kp QUESTION
                &trans     &trans         &trans            &Symbols_System_Layouts_m           &Emoji_System_Layouts_m  &trans             &trans                               &trans           &trans             &trans          &trans
            >;
        };

        iPad-UA-Symbols {
            bindings = <
&kp EXCL               &kp UNDER  &kp LC(LA(LS(COMMA)))  &kp LC(LA(LEFT_BRACKET))      &kp LC(LA(GRAVE))                   &kp LA(N3)               &kp LC(LA(RIGHT_BRACKET))      &kp LA(LC(LG(PERIOD)))               &kp LA(LC(LS(N7)))             &trans
