        MacKarabinerUK_Macro: MacKarabinerUK {
            /*
			Macro is mandatory. As keyboard must switch layout too (in addition to sending langeage changing key sequence
			to karabener which is possible wo macro)

			For rdp/vnc/remote Karabiner doesn't work. To switch system layouts remotely bypass karabiner.
			For example by using Apple Script added as a service with shortcut.
		*/

            compatible = "zmk,behavior-macro";
            tap-ms = <0>;
            wait-ms = <0>;
            #binding-cells = <0>;
            bindings = <&kp F22>;
            label = "MACKARABINERUK";
