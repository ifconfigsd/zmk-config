    combos {
        compatible = "zmk,combos";

        #include "includes/cyrillic_letters_combos.dtsi"

        combo_CmdTAbAppSW {
            bindings = <&CmdTAb_App_SW_m>;
            key-positions = <34 25>;
            layers = <0 1 2 3>;
            timeout-ms = <150>;
        };

        Mac_OneHanded_Sticky_Command {
            bindings = <&Sticky_1500ms LEFT_COMMAND>;
            key-positions = <24 23>;
            layers = <0 1 8 2 3>;
        };

        Ubuntu_OneHanded_Sticky_Control {
            bindings = <&Sticky_1500ms LEFT_CONTROL>;
            key-positions = <24 23>;
            layers = <27>;
        };

        Mac-Switch-To-UA-combo {
            /*
                Should only possible when Ukrainian language is in use (i.e. combo active on Ua shortcuts fix layer is on).
                On this depends syncronized swithcing of OS language & ZMK layouts for iPad
            */

            bindings = <&Mac_Switch_To_UA_m>;
            key-positions = <28 29>;
            layers = <0>;
            timeout-ms = <170>; // must be less than hold-tap of a key that used both in hold-tap and combo. Or there will be race conditions and WATs.
        };

        Mac-Switch-To-EN-combo {
            /*
                Should only possible when Englist language is in use (i.e. combo active on Colemac layer only).
                On this depends syncronized swithcing of OS language & ZMK layouts for iPad
            */

            bindings = <&Mac_Switch_To_EN_m>;
            key-positions = <27 28>;
            layers = <1>;
            timeout-ms = <170>; // must be less than hold-tap of a key that used both in hold-tap and combo. Or there will be race conditions and WATs.
        };

        Mac_Suppress-EN-for-EN {
            // when En Seleced, combo to switch to EN disabled. When you blindly hit keys of this combo, to ensure you
            // on EN, being on EN already, itnsead of combo you get letters typed. This is annoying to delete then.
            // So suppress these combination of letters, by having them in a same combo as EN but producing nothing.

            bindings = <&none>;
            key-positions = <28 27>;
            timeout-ms = <170>;
            layers = <0>;
        };

        Mac-UA-Accent-Dead-Key {
            /*
                Second role is Supressor for Ua/Uk. Read in other's conterpart combos. Either not delete, or implement
                then this role elswere.
            */

            bindings = <&kp LA(KP_NUMBER_0)>;
            key-positions = <28 29>;
            timeout-ms = <170>;
            layers = <1>;
        };

        iPad-Switch-To-EN-combo {
            // Read in Mac counterpat combo

            bindings = <&iPad_EN_m>;
            key-positions = <27 28>;
            timeout-ms = <190>; // must be less than hold-tap of a key that used both in hold-tap and combo. Or there will be race conditions and WATs
            layers = <3>;
        };

        iPad-Switch-To-UA-combo {
            // Read in Mac counterpat combo

            bindings = <&iPad_UA_m>;
            key-positions = <28 29>;
            timeout-ms = <190>; // must be less than hold-tap of a key that used both in hold-tap and combo. Or there will be race conditions and WATs
            layers = <2>;
        };

        iPad-Suppress-EN-for-EN-combo {
            // read mac counterpart combos or search "supress"

            bindings = <&none>;
            key-positions = <28 27>;
            timeout-ms = <190>;
            layers = <2>;
        };

        iPad-Suppress-UA-for-UA-combo {
            // read mac counterpart combos or search "supress"

            bindings = <&none>;
            key-positions = <28 29>;
            timeout-ms = <190>;
            layers = <3>;
        };

        Delete_Word_Apple {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <17 18>;
            layers = <0 1 2 3>;
            require-prior-idle-ms = <320>;
        };

        Delete_Word_Ubuntu {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <17 18>;
            require-prior-idle-ms = <320>;
            layers = <27>;
        };

        AppWindowsSwNext1 {
            bindings = <&kp LG(GRAVE)>;
            key-positions = <21 14>;
            timeout-ms = <150>;
            layers = <0 1>;
        };

        AppWindowsSwPrevP1 {
            bindings = <&kp LG(LS(GRAVE))>;
            key-positions = <21 11>;
            timeout-ms = <150>;
            layers = <0 1>;
        };

        AppWindowsSwPrevP2 {
